{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "required": ["cases"],
  "properties": {"cases": {"type": "array", "items": {
    "type": "object", "required": ["id", "reqs", "title", "expected"],
    "properties": {"id": {"type": "string", "pattern": "^TC-\\d{3}$"},
      "reqs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^REQ-\\d{3}$"}},
      "title": {"type": "string"}, "preconditions": {"type": "array"}, "steps": {"type": "array"},
      "expected": {"type": "string"}, "type": {"enum": ["positive", "negative", "boundary"]},
      "parallel_safe": {"type": "boolean"}, "data": {"type": "object"}}}}}
}
