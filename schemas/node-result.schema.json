{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["node", "status", "artifacts", "exit_criteria", "summary"],
  "properties": {
    "node": {"type": "string"},
    "status": {"enum": ["done", "blocked", "needs_human", "failed"]},
    "artifacts": {"type": "array", "items": {"type": "string"}},
    "tickets_requested": {"type": "array", "items": {"type": "object", "properties": {"kind": {"type": "string"}, "agent": {"type": "string"}, "title": {"type": "string"}, "reqs": {"type": "array", "items": {"type": "string"}}, "blocked_by": {"type": "array", "items": {"type": "string"}}}}},
    "exit_criteria": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "decisions": {"type": "array", "items": {"type": "string"}},
    "open_questions": {"type": "array", "items": {"type": "string"}},
    "summary": {"type": "string"},
    "tokens": {"type": "object", "properties": {"in": {"type": "integer"}, "out": {"type": "integer"}}}
  }
}
