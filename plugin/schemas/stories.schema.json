{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["stories"],
  "properties": {"stories": {"type": "array", "items": {
    "type": "object", "required": ["id", "reqs", "owns", "dod"],
    "properties": {"id": {"type": "string"}, "title": {"type": "string"},
      "reqs": {"type": "array", "items": {"type": "string", "pattern": "^REQ-\\d{3}$"}},
      "depends": {"type": "array", "items": {"type": "string"}},
      "owns": {"type": "array", "minItems": 1, "items": {"type": "string"}},
      "dod": {"type": "array", "minItems": 1, "items": {"type": "string"}},
      "contract_refs": {"type": "array", "items": {"type": "string"}}}}}}
}
